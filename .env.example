# Inject values through the process environment. This file is not auto-loaded.
# Private directories and real input files must stay outside the repository.
PRIVATE_DATA_DIR=
PRIVATE_CONFIG_DIR=
METADATA_PATH=
METADATA_EXPECTED_HASH=

# Select mock/openai/gms providers in private runtime.json; mock is the default.
# Keys alone never start GMS requests. Explicit LIVE scope and approved source,
# question, request/byte limits and a confirmed credit profile are required.
# Normal status/API/Streamlit/workers/tests do not grant GMS LIVE scope.

# GMS gateway: fixed public origin; the application rejects other gateway URLs.
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_CHAT_MODEL=
GMS_CHAT_MODEL_VERSION=
# Confirm the model/route combination before selecting it in runtime.json.
# LIVE route: chat/completions. The responses format/parser is configured only;
# responses is currently LIVE-disabled regardless of budget profile settings.
GMS_CHAT_ROUTE=
# Required confirmed chat output bound: integer 1..4096. Blank is unready.
GMS_MAX_OUTPUT_TOKENS=
GMS_EMBEDDING_MODEL=
GMS_EMBEDDING_MODEL_VERSION=
# Confirm the actual returned dimension: integer 1..8192. Blank is unready.
# The GMS wire request does not send a dimensions field.
GMS_EMBEDDING_DIMENSION=

# Separate OpenAI adapter configuration, only when that provider is selected.
OPENAI_API_KEY=
CHAT_MODEL=
CHAT_MODEL_VERSION=
EMBEDDING_MODEL=
EMBEDDING_MODEL_VERSION=
EMBEDDING_DIMENSION=

# Private runtime.json usage limits default to zero; live_budget.json remains
# unconfirmed until actual pricing, bounds and purpose allocations are reviewed.
# The project GMS cap is 70,000 credits including embeddings. Cache hits make
# no new reservation/HTTP request. Failures and unknown outcomes keep reserves.

ENABLE_REMOTE_MODELS=false
DEMO_MODE=true
# Settlement retries: integer 1..10, overridden by runtime.json settlement.max_attempts.
MAX_SETTLEMENT_ATTEMPTS=3
# Upload remains disabled until the actual inspection path is available.
ENABLE_REAL_UPLOADS=false
